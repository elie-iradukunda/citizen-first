# Set to development on a developer machine. Anything else is treated as
# production, which withholds password-reset links from API responses.
NODE_ENV=development
PORT=4000
PORT_RETRY_ATTEMPTS=5
CLIENT_URL=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_NAME=citizen_first
DB_USER=root
DB_PASSWORD=
DB_AUTO_CREATE_DATABASE=true
DB_SYNC_ALTER=false
DB_SYNC_FORCE=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
APP_NAME=SACCFP
PUBLIC_APP_URL=http://localhost:5173
# brevo (HTTP API — the one that works on Railway, any recipient),
# resend (HTTP API, but the sandbox sender only delivers to the account owner),
# smtp (any relay, blocked on Railway — every SMTP port including 2525 is), or
# gmail (local only, same SMTP block applies when hosted).
MAIL_PROVIDER=gmail
BREVO_API_KEY=xkeysib-your-brevo-api-key
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your-google-app-password
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=your-smtp-login
SMTP_PASSWORD=your-smtp-key
MAIL_FROM=SACCFP <youraddress@gmail.com>
MAIL_REPLY_TO=
MAIL_TIMEOUT_MS=10000
SYSTEM_ADMIN_ACCESS_KEY=CF-ADMIN-2026
TEST_ADMIN_ACCESS_KEY=CF-TEST-ADMIN-2026
DASHBOARD_CITIZEN_ACCESS_KEY=CF-CITIZEN-2026
DASHBOARD_INSTITUTION_ADMIN_ACCESS_KEY=CF-INSTITUTION-2026
DASHBOARD_RIB_OFFICER_ONE_ACCESS_KEY=CF-RIB-OFFICER1-2026
DASHBOARD_RIB_OFFICER_TWO_ACCESS_KEY=CF-RIB-OFFICER2-2026
SYSTEM_ADMIN_EMAIL=kasinelydivine30000@gmail.com
SYSTEM_ADMIN_PASSWORD=kasine2003
TEST_ADMIN_EMAIL=test.admin@citizenfirst.gov.rw
TEST_ADMIN_PASSWORD=Admin@12345
DASHBOARD_CITIZEN_EMAIL=citizen.demo@saccfp.rw
DASHBOARD_CITIZEN_PASSWORD=Citizen@12345
DASHBOARD_INSTITUTION_ADMIN_EMAIL=institution.admin@saccfp.rw
DASHBOARD_INSTITUTION_ADMIN_PASSWORD=Institution@12345
DASHBOARD_RIB_OFFICER_ONE_EMAIL=rib.officer1@saccfp.rw
DASHBOARD_RIB_OFFICER_ONE_PASSWORD=RibOfficer1@12345
DASHBOARD_RIB_OFFICER_TWO_EMAIL=rib.officer2@saccfp.rw
DASHBOARD_RIB_OFFICER_TWO_PASSWORD=RibOfficer2@12345
SEED_HIERARCHY_TEST_DATA=true
